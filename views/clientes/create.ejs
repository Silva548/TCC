<h1>Cadastrar novo cliente</h1>

<% if (erro) { %>
    <div class="alert alert-danger"><%= erro %></div>
<% } %>

<form action="/clientes" method="POST">
    <%- include('../partials/csrf') %>
    <div class="form-group">
        <label for="nome">Nome</label>
        <input type="text" class="form-control" id="nome" name="nome" value="<%= body && body.nome ? body.nome : '' %>" maxlength="255" required>
    </div>
    <div class="form-group">
        <label for="email">E-mail</label>
        <input type="email" class="form-control" id="email" name="email" value="<%= body && body.email ? body.email : '' %>" required>
    </div>
    <div class="form-group">
        <label for="documento">Documento (CPF/CNPJ)</label>
        <input type="text" class="form-control" id="documento" name="documento" value="<%= body && body.documento ? body.documento : '' %>" maxlength="20" required>
    </div>
    <div class="form-group">
        <label for="telefone">Telefone</label>
        <input type="text" class="form-control" id="telefone" name="telefone" value="<%= body && body.telefone ? body.telefone : '' %>" maxlength="20">
    </div>
    <div class="form-group">
        <label for="tipo">Tipo</label>
        <select class="form-control" id="tipo" name="tipo">
            <option value="B2C" <%= !body || body.tipo !== 'B2B' ? 'selected' : '' %>>B2C (Pessoa física)</option>
            <option value="B2B" <%= body && body.tipo === 'B2B' ? 'selected' : '' %>>B2B (Empresa)</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Cadastrar</button>
</form>
