<h1>Lista de clientes</h1>

<a href="/clientes/new" class="btn btn-success mb-3">Novo Cliente</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Documento</th>
            <th>Telefone</th>
            <th>Tipo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% clientes.forEach(cliente => { %>
            <tr>
                <td><%= cliente.id %></td>
                <td><%= cliente.nome %></td>
                <td><%= cliente.email %></td>
                <td><%= cliente.documento %></td>
                <td><%= cliente.telefone || '-' %></td>
                <td><%= cliente.tipo %></td>
                <td>
                    <a href="/clientes/<%= cliente.id %>" class="btn btn-primary">View</a>
                    <a href="/clientes/<%= cliente.id %>/edit" class="btn btn-warning">Edit</a>
                    <form action="/clientes/<%= cliente.id %>?_method=DELETE" method="POST" style="display: inline;">
                        <%- include('../partials/csrf') %>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<%- include("../partials/pagination", { caminhoBase: "/clientes" }) %>
