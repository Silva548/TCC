<h1>Lista de categorias</h1>

<%# Mensagem de erro trazida pelo controller após uma recusa (ex.: exclusão
    bloqueada por FK). Vem na query porque o app não tem sessão de flash. %>
<% if (typeof erro !== 'undefined' && erro) { %>
    <div class="alert alert-danger"><%= erro %></div>
<% } %>

<a href="/categorias/new" class="btn btn-success mb-3">Nova Categoria</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Categoria</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% categorias.forEach(categoria => { %>
            <tr>
                <td><%= categoria.id %></td>
                <td><%= categoria.nome %></td>
                <td>
                    <a href="/categorias/<%= categoria.id %>" class="btn btn-primary">View</a>
                    <a href="/categorias/<%= categoria.id %>/edit" class="btn btn-warning">Edit</a>
                    <form action="/categorias/<%= categoria.id %>?_method=DELETE" method="POST" style="display: inline;">
                        <%- include('../partials/csrf') %>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<%- include("../partials/pagination", { caminhoBase: "/categorias" }) %>
