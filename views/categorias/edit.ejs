<h1>Editar categoria</h1>

<% if (erro) { %>
    <div class="alert alert-danger"><%= erro %></div>
<% } %>

<form action="/categorias/<%= categoria.id %>?_method=PUT" method="POST">
    <%- include('../partials/csrf') %>
    <div class="form-group">
        <label for="nome">Categoria</label>
        <input type="text" class="form-control" id="nome" name="nome" value="<%= body && body.nome ? body.nome : (categoria.nome || '') %>" maxlength="255" required>
    </div>
    <button type="submit" class="btn btn-warning">Salvar</button>
</form>
