<h1>Cadastrar novo produto</h1>

<% if (erro) { %>
    <div class="alert alert-danger"><%= erro %></div>
<% } %>

<form action="/produtos" method="POST">
    <%- include('../partials/csrf') %>
    <div class="form-group">
        <label for="nome">Nome do Produto:</label>
        <input type="text" class="form-control" id="nome" name="nome" value="<%= body && body.nome ? body.nome : '' %>" maxlength="255" required>
    </div>
    <div class="form-group">
        <label for="descricao">Descrição:</label>
        <textarea id="descricao" class="form-control" name="descricao"><%= body && body.descricao ? body.descricao : '' %></textarea>
    </div>
    <div class="form-group">
        <label for="embalagem">Embalagem:</label>
        <select class="form-control" id="embalagem" name="embalagem" required>
            <option value="">Selecione</option>
            <% const embalagemAtual = body && body.embalagem ? body.embalagem : ''; %>
            <option value="premium" <%= embalagemAtual === 'premium' ? 'selected' : '' %>>Premium</option>
            <option value="basica" <%= embalagemAtual === 'basica' ? 'selected' : '' %>>Básica</option>
        </select>
    </div>
    <div class="form-row">
        <div class="form-group col-md-6">
            <label for="preco_entrega">Preço de entrega (R$):</label>
            <input type="number" step="0.01" min="0.01" class="form-control" id="preco_entrega" name="preco_entrega" value="<%= body && body.preco_entrega ? body.preco_entrega : '' %>" required>
        </div>
        <div class="form-group col-md-6">
            <label for="preco_retirada">Preço de retirada (R$):</label>
            <input type="number" step="0.01" min="0.01" class="form-control" id="preco_retirada" name="preco_retirada" value="<%= body && body.preco_retirada ? body.preco_retirada : '' %>" required>
        </div>
    </div>
    <div class="form-group">
        <label for="peso_kg">Peso (kg):</label>
        <input type="number" step="0.01" min="0.01" class="form-control" id="peso_kg" name="peso_kg" value="<%= body && body.peso_kg ? body.peso_kg : '' %>" required>
    </div>
    <div class="form-group">
        <label for="estoque">Estoque:</label>
        <input type="number" min="0" step="1" class="form-control" id="estoque" name="estoque" value="<%= body && body.estoque !== undefined ? body.estoque : 0 %>" required>
    </div>
    <div class="form-group">
        <label for="categoria_id">Categoria:</label>
        <select class="form-control" id="categoria_id" name="categoria_id">
            <option value="">Sem categoria</option>
            <% categorias.forEach(categoria => { %>
                <option value="<%= categoria.id %>" <%= String(body && body.categoria_id) === String(categoria.id) ? 'selected' : '' %>><%= categoria.nome %></option>
            <% }) %>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Cadastrar</button>
</form>
