<%
    const { moeda, rotuloEmbalagem } = formatadores;
%>

<h1>Detalhes do produto</h1>
<p>ID: <%= produto.id %></p>
<p>Nome: <%= produto.nome %></p>
<p>Categoria: <%= produto.Categoria ? produto.Categoria.nome : 'Sem categoria' %></p>
<p>Descrição: <%= produto.descricao || '-' %></p>
<p>Embalagem: <%= rotuloEmbalagem(produto.embalagem) %></p>
<p>Preço de entrega: <%= moeda(produto.preco_entrega) %></p>
<p>Preço de retirada: <%= moeda(produto.preco_retirada) %></p>
<p>Peso: <%= produto.peso_kg %> kg</p>
<p>Estoque: <%= produto.estoque %></p>
<a href="/produtos/<%= produto.id %>/edit" class="btn btn-warning">Editar</a>
<a href="/produtos" class="btn btn-primary">Voltar</a>
