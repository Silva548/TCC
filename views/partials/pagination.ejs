<%# Exibe navegação de páginas. Espera: paginacao = { pagina, limite, total_paginas } e caminhoBase (ex.: '/produtos') %>
<% if (paginacao && paginacao.total_paginas > 1) { %>
    <nav aria-label="Navegação de páginas" class="mt-3">
        <ul class="pagination">
            <li class="page-item <%= paginacao.pagina <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="<%= caminhoBase %>?page=<%= paginacao.pagina - 1 %>&limit=<%= paginacao.limite %>" aria-label="Anterior">&laquo;</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Página <%= paginacao.pagina %> de <%= paginacao.total_paginas %></span>
            </li>
            <li class="page-item <%= paginacao.pagina >= paginacao.total_paginas ? 'disabled' : '' %>">
                <a class="page-link" href="<%= caminhoBase %>?page=<%= paginacao.pagina + 1 %>&limit=<%= paginacao.limite %>" aria-label="Próxima">&raquo;</a>
            </li>
        </ul>
    </nav>
<% } %>
