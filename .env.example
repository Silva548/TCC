# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DB_HOST="localhost"
DB_USER="postgres"
DB_PASSWORD="sua_senha"
DB_NAME="carvao_dois_irmaos"
DB_PORT="5432"

# Alternativa ao bloco acima, para hospedagens gerenciadas (Render, Railway,
# RDS). TEM PRECEDÊNCIA sobre DB_*: definida, as variáveis acima são ignoradas.
# sslmode=require liga o TLS.
# DATABASE_URL="postgres://usuario:senha@host:5432/banco?sslmode=require"

# TLS sem URL. Só para quem conecta por variáveis.
# DB_SSL="true"

# Orçamento de conexões: DB_POOL_MAX + DB_SESSION_POOL_MAX precisa ficar abaixo
# do max_connections do servidor, contando também as conexões reservadas a
# superusuário. O default abaixo (10 + 3 = 13) serve para o max_connections
# padrão de 100.
# DB_POOL_MAX="10"
# DB_SESSION_POOL_MAX="3"
# DB_POOL_IDLE_MS="30000"

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"

# Senha do admin criado por "npm run seed". Sem ela, em produção a senha é gerada
# aleatoriamente e exibida uma única vez no log do seed. Defina-a para escolher
# a senha em vez de depender do log.
# ADMIN_SENHA="troque-esta-senha"

# Obrigatório em produção: sem isto o app não sobe (ver app.js).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="gere-um-segredo-aleatorio-com: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""

# ---------------------------------------------------------------------------
# Limitação de requisições
# ---------------------------------------------------------------------------
# Requisições por janela de 15 min, por IP, no app inteiro.
# RATE_LIMIT_MAX="100"
# Tentativas de login por janela de 15 min, por IP.
# LOGIN_RATE_LIMIT="10"

# ---------------------------------------------------------------------------
# Proxy reverso
# ---------------------------------------------------------------------------
# Só habilite se houver mesmo nginx/Load Balancer na frente. Sem proxy, ligar
# isto faz o Express confiar no cabeçalho X-Forwarded-For e um cliente poderia
# forjar o IP para escapar do rate limiting.
# TRUST_PROXY="true"

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Vazio = same-origin only (padrão seguro). Liste origens separadas por vírgula
# para permitir chamadas de outra origem.
# CORS_ORIGINS="https://exemplo.com,https://outro.com"

# ---------------------------------------------------------------------------
# Testes
# ---------------------------------------------------------------------------
# Banco separado, obrigatório para `npm test`. O setup-test-db.js recusa
# rodar se for igual a DB_NAME — apagar o banco de desenvolvimento seria
# irreversível.
# DB_NAME_TEST="carvao_dois_irmaos_test"
# Banco administrativo usado só para criar o DB_NAME_TEST acima.
# DB_ADMIN_NAME="postgres"